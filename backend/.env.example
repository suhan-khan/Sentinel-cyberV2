# ===================================================
# Sentinel Cyber — Backend Environment Configuration
# ===================================================

# Server Port (Render sets $PORT automatically in production)
PORT=8000
HOST=0.0.0.0

# Sensor Authentication Secret
# For local development: leave blank or set any dev token.
# For production Render: generate a 32+ character random secret string!
SENTINEL_SENSOR_TOKEN=replace-with-a-long-random-token

# Maximum CSV upload size in Megabytes
SENTINEL_MAX_UPLOAD_MB=50

# ML Inference Decision Threshold for Attack Classification (0.0 to 1.0)
SENTINEL_DECISION_THRESHOLD=0.05

# CORS Allowed Origins (Comma-separated list of frontends)
# Example for production: https://sentinel-cyber.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://sentinel-cyber.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
CORS_ALLOW_ALL=false