# ===============================================================
# Sentinel Cyber — Multi-Environment Configuration Guide (.env)
# ===============================================================

# ---------------------------------------------------------------
# 1. WINDOWS TELEMETRY SENSOR CONFIGURATION
# ---------------------------------------------------------------
# Target FastAPI backend URL for the Windows Sensor.
# - For Local Development:
SENTINEL_API_URL=http://127.0.0.1:8000
# - For Production Render Deployment (uncomment when running against Render):
# SENTINEL_API_URL=https://sentinel-cyber.onrender.com

# Sensor Authentication Token (must match backend's SENTINEL_SENSOR_TOKEN)
SENTINEL_SENSOR_TOKEN=sentinel-local-dev-token

# ---------------------------------------------------------------
# 2. FASTAPI BACKEND CONFIGURATION
# ---------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
SENTINEL_MAX_UPLOAD_MB=50
SENTINEL_DECISION_THRESHOLD=0.05

# CORS Origins (allow your Vercel deployment URL and localhost)
CORS_ALLOWED_ORIGINS=https://sentinel-cyber.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
CORS_ALLOW_ALL=true
